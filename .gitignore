# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files — but NOT the Gradle wrapper jar (it must be committed so
# clone-and-build works without a pre-installed Gradle distribution)
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
# Exclude application jars but keep gradle-wrapper.jar
build/libs/*.jar
!gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
