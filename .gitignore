# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files — but NOT the Gradle wrapper jar (it must be committed so
# clone-and-build works without a pre-installed Gradle distribution)
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
# Exclude application jars but keep gradle-wrapper.jar
build/libs/*.jar
!gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs
hs_err_pid*
replay_pid*

# Terraform — never commit state files or sensitive data
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
.terraform/
.terraform.lock.hcl
terraform.tfvars
*.auto.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
